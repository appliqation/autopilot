# appq connection — used for the read-only context tools this agent reasons
# over (get_scenario, get_failure_patterns, get_defect_context, etc).
APPQ_ORIGIN=https://appq.appliqation.io
APPQ_API_KEY=

# Set exactly one LLM provider — checked in this order, first configured
# wins: Anthropic, OpenAI, DeepSeek, GLM.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_MODEL=
OPENAI_MODEL=
ANTHROPIC_MAX_TOKENS=8192
OPENAI_MAX_OUTPUT_TOKENS=8192

# DeepSeek and Zhipu's GLM — both OpenAI Chat Completions-compatible, routed
# through the same generic adapter. Unlike Anthropic/OpenAI, there is no
# built-in default model here — DEEPSEEK_MODEL/GLM_MODEL are REQUIRED when
# that provider is selected (model IDs on both move fast; a silently stale
# hardcoded default would be worse than an explicit startup error). Base
# URLs default to the public endpoints — override only for a proxy/self-host.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MAX_TOKENS=8192
GLM_API_KEY=
GLM_MODEL=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MAX_TOKENS=8192
# Note: this agent doesn't attach screenshots itself, so the vision-support
# caveat that matters for browser-driving sibling agents (autotest/explorer/
# heal-selector/visual-regression) doesn't apply here.

# Overall tool-calling loop budget for one `run` invocation. Generous
# relative to the sibling agents — a real routing decision needs several
# rounds: gather context, reason, act, re-evaluate a real result, act again.
BUDGET_MAX_CALLS=40
BUDGET_MAX_MILLIS=1800000
BUDGET_MAX_TURNS=30
# Broad backstop against runaway spend, not a tuned budget (the caps above
# normally end a run first). Total tokens across the whole run, cache included.
BUDGET_MAX_TOTAL_TOKENS=2000000

# How to invoke the seven sibling agents. Defaults assume the real npm
# packages are installed and on PATH. Override to point at a local dev
# checkout, e.g.:
#   AUTOTEST_CMD="node /path/to/appliqation-autotest/dist/cli/index.js"
AUTOTEST_CMD=appliqation-autotest
SCRIPTGEN_CMD=appliqation-scriptgen
PR_RAISE_CMD=appliqation-pr-raise
DEFECT_FIX_CMD=appliqation-defect-fix
EXPLORER_CMD=appliqation-explorer
HEAL_CMD=appliqation-heal-selector
VISUAL_CMD=appliqation-visual-regression
COMMAND_TIMEOUT_MS=1200000

# Optional: point at your own decision policy instead of the bundled one
# (src/policy/systemPrompt.ts) — see the README's "Customizing the policy"
# section. --policy on the CLI takes precedence over this if both are set.
POLICY_FILE=

# Audit logging — entirely opt-in, nothing is recorded anywhere unless one of
# these is set. Precedence: Mongo (if fully configured) > JSONL > none. This
# is a parallel system's own audit trail, deliberately not part of appq —
# see @appliqation/agent-core's audit/sink.ts. AUDIT_MONGO_DB/_COLLECTION
# are required together with AUDIT_MONGO_URI — no default collection name.
AUDIT_MONGO_URI=
AUDIT_MONGO_DB=
AUDIT_MONGO_COLLECTION=
AUDIT_JSONL_PATH=
